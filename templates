<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Sales Return Prediction</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
      }

      body {
        background: #f4f7fb;
        color: #222;
      }

      .container {
        width: 90%;
        max-width: 1200px;
        margin: 40px auto;
      }

      .header {
        text-align: center;
        margin-bottom: 35px;
      }

      .header h1 {
        font-size: 36px;
        margin-bottom: 10px;
      }

      .header p {
        color: #666;
        font-size: 16px;
      }

      .card {
        background: white;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
      }

      .section {
        margin-bottom: 35px;
      }

      .section-header {
        margin-bottom: 22px;
        padding-bottom: 12px;
        border-bottom: 2px solid #eee;
      }

      .section-header h2 {
        font-size: 21px;
      }

      .section-header p {
        color: #777;
        font-size: 14px;
        margin-top: 5px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .input-group {
        display: flex;
        flex-direction: column;
      }

      label {
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 14px;
      }

      input,
      select {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 15px;
        outline: none;
        background: white;
      }

      input:focus,
      select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.1);
      }

      .button-container {
        text-align: center;
        margin-top: 10px;
      }

      button {
        padding: 15px 50px;
        border: none;
        border-radius: 9px;
        background: #4f46e5;
        color: white;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
      }

      button:hover {
        background: #3730a3;
      }

      .result {
        margin-top: 35px;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
        background: #f5f5ff;
      }

      .result h2 {
        margin-bottom: 10px;
        font-size: 25px;
      }

      .returned {
        color: #dc2626;
      }

      .not-returned {
        color: #16a34a;
      }

      .probability {
        font-size: 18px;
        margin-top: 8px;
      }

      @media (max-width: 900px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 600px) {
        .grid {
          grid-template-columns: 1fr;
        }

        .container {
          width: 95%;
        }

        .card {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- HEADER -->
      <div class="header">
        <h1>📊 Sales Return Prediction</h1>
        <p>
          Predict whether an order is likely to be returned using Machine
          Learning.
        </p>
      </div>

      <div class="card">
        <form action="/predict" method="POST">
          <!-- ================= ORDER INFORMATION ================= -->

          <div class="section">
            <div class="section-header">
              <h2>🛒 Order Information</h2>
              <p>Enter the details related to the customer's order.</p>
            </div>

            <div class="grid">
              <div class="input-group">
                <label>Order Date</label>
                <input type="date" name="Order_Date" required />
              </div>

              <div class="input-group">
                <label>Category</label>
                <input
                  type="text"
                  name="Category"
                  placeholder="e.g. Electronics"
                  required
                />
              </div>

              <div class="input-group">
                <label>Sub Category</label>
                <input
                  type="text"
                  name="Sub_Category"
                  placeholder="e.g. Mobile"
                  required
                />
              </div>

              <div class="input-group">
                <label>Brand</label>
                <input
                  type="text"
                  name="Brand"
                  placeholder="e.g. Samsung"
                  required
                />
              </div>

              <div class="input-group">
                <label>Quantity</label>
                <input type="number" name="Quantity" min="1" required />
              </div>

              <div class="input-group">
                <label>Unit Price</label>
                <input type="number" step="0.01" name="Unit_Price" required />
              </div>

              <div class="input-group">
                <label>Discount Percent</label>
                <input
                  type="number"
                  step="0.01"
                  name="Discount_Percent"
                  min="0"
                  max="100"
                  required
                />
              </div>

              <div class="input-group">
                <label>Payment Method</label>
                <select name="Payment_Method" required>
                  <option value="UPI">UPI</option>
                  <option value="Credit Card">Credit Card</option>
                  <option value="Debit Card">Debit Card</option>
                  <option value="Cash">Cash</option>
                  <option value="Net Banking">Net Banking</option>
                </select>
              </div>

              <div class="input-group">
                <label>Sales Channel</label>
                <select name="Sales_Channel" required>
                  <option value="Online">Online</option>
                  <option value="Offline">Offline</option>
                </select>
              </div>
            </div>
          </div>

          <!-- ================= CUSTOMER INFORMATION ================= -->

          <div class="section">
            <div class="section-header">
              <h2>👤 Customer Information</h2>
              <p>Enter the customer's demographic and location details.</p>
            </div>

            <div class="grid">
              <div class="input-group">
                <label>Gender</label>
                <select name="Gender" required>
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                </select>
              </div>

              <div class="input-group">
                <label>Age</label>
                <input type="number" name="Age" min="1" max="100" required />
              </div>

              <div class="input-group">
                <label>City</label>
                <input
                  type="text"
                  name="City"
                  placeholder="e.g. New Delhi"
                  required
                />
              </div>

              <div class="input-group">
                <label>State</label>
                <input
                  type="text"
                  name="State"
                  placeholder="e.g. Delhi"
                  required
                />
              </div>

              <div class="input-group">
                <label>Region</label>
                <select name="Region" required>
                  <option value="North">North</option>
                  <option value="South">South</option>
                  <option value="East">East</option>
                  <option value="West">West</option>
                </select>
              </div>

              <div class="input-group">
                <label>Customer Type</label>
                <select name="Customer_Type" required>
                  <option value="Regular">Regular</option>
                  <option value="New">New</option>
                  <option value="Premium">Premium</option>
                </select>
              </div>
            </div>
          </div>

          <!-- ================= BUSINESS INFORMATION ================= -->

          <div class="section">
            <div class="section-header">
              <h2>💼 Business Information</h2>
              <p>Enter the financial and sales-related details.</p>
            </div>

            <div class="grid">
              <div class="input-group">
                <label>Sales</label>
                <input type="number" step="0.01" name="Sales" required />
              </div>

              <div class="input-group">
                <label>Cost</label>
                <input type="number" step="0.01" name="Cost" required />
              </div>

              <div class="input-group">
                <label>Profit</label>
                <input type="number" step="0.01" name="Profit" required />
              </div>

              <div class="input-group">
                <label>Sales Person</label>
                <input
                  type="text"
                  name="Sales_Person"
                  placeholder="e.g. Rahul"
                  required
                />
              </div>
            </div>
          </div>

          <!-- ================= PREDICT BUTTON ================= -->

          <div class="button-container">
            <button type="submit">Predict Return</button>
          </div>
        </form>
        <a href="/" class="reset-btn"> Reset </a>
        <!-- ================= RESULT ================= -->

        {% if prediction %}

        <div class="result-card">
          {% if prediction == "Returned" %}

          <div class="result-icon">🔴</div>

          <h2 class="returned">Returned</h2>

          <p class="result-message">This order is predicted to be returned.</p>

          {% else %}

          <div class="result-icon">🟢</div>

          <h2 class="not-returned">Not Returned</h2>

          <p class="result-message">
            This order is predicted not to be returned.
          </p>

          {% endif %}

          <div class="probability-box">
            <div class="probability-item">
              <span>Return Probability</span>
              <strong>{{ return_probability }}%</strong>
            </div>

            <div class="probability-item">
              <span>Not Return Probability</span>
              <strong>{{ not_return_probability }}%</strong>
            </div>
          </div>

          <div class="model-info">
            Prediction generated using
            <strong>Decision Tree Machine Learning Model</strong>
          </div>
        </div>

        {% endif %}
      </div>
    </div>
  </body>
</html>
